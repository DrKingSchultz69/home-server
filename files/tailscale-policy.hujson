// Tailscale access rules for the homeserver tailnet (Phase 11).
// Paste into: Tailscale console -> Access controls -> JSON editor (replace everything), then Save.
//   Owner (you):  every device, every port.
//   Family:       only the dashboard (8446; 443 redirects there), their files (8444), streaming (8445)
//                 and the Watcher app backend (8447, limits them to their role) on homeserver. Netheron (8443), alerts (10000), SSH and the Z: drive (445) stay closed.
//   Public:       Funnel on homeserver :443 only = the join request page (requests/).
{
	"hosts": {
		"homeserver": "100.114.125.48",
	},

	"acls": [
		{"action": "accept", "src": ["autogroup:owner", "autogroup:admin"], "dst": ["*:*"]},
		{"action": "accept", "src": ["autogroup:member"], "dst": ["homeserver:443,8444,8445,8446,8447"]},
	],

	// Funnel (public join request page): only the owner's devices may turn it on.
	"nodeAttrs": [
		{"target": ["shairaam12@gmail.com"], "attr": ["funnel"]},
	],

	// Tailscale SSH: each person only into their own devices, never as root, re-check sign-in.
	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
		},
	],

	// The console runs these when you save; a failing test blocks the save.
	"tests": [
		{
			"src":    "shairaam12@gmail.com",
			"accept": ["homeserver:443", "homeserver:8443", "homeserver:8444", "homeserver:8445", "homeserver:8446", "homeserver:8447", "homeserver:10000", "homeserver:22"],
		},
	],
}
